{
  "name": "live-coco",
  "version": "0.0.0",
  "private": true,
  "description": "Tamil Nadu coconut price intelligence and verified B2B marketplace",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm start -w @livecoco/api",
    "dev:worker": "npm start -w @livecoco/worker",
    "dev:web": "npm run dev -w @livecoco/web",
    "build:web": "npm run build -w @livecoco/web",
    "start:web": "node --import tsx ./apps/web/src/server.ts",
    "build": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "lint": "node ./scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p apps/web/tsconfig.json",
    "docs:check": "node ./scripts/check-doc-links.mjs && node --import tsx ./scripts/gen-endpoints.mjs --check",
    "db:migrate": "node --import tsx ./packages/database/src/cli.ts migrate",
    "db:reset": "node --import tsx ./packages/database/src/cli.ts reset",
    "test:e2e": "npm run build:web && node --import tsx ./tests/e2e/ui.e2e.mjs",
    "seed": "node --import tsx ./scripts/seed.mjs",
    "docs:endpoints": "node --import tsx ./scripts/gen-endpoints.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "@livecoco/test-support": "*"
  },
  "dependencies": {},
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/worker",
    "apps/web"
  ]
}
