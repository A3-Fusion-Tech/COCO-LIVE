{
  "name": "live-coco",
  "version": "0.0.0",
  "private": true,
  "description": "Tamil Nadu coconut price intelligence and verified B2B marketplace",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./apps/api/src/main.ts",
    "dev:worker": "node ./apps/worker/src/main.ts",
    "dev:web": "node ./apps/web/src/server.ts",
    "build": "tsc -p tsconfig.check.json",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "lint": "node ./scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "docs:check": "node ./scripts/check-doc-links.mjs && node ./scripts/gen-endpoints.mjs --check",
    "db:migrate": "node ./packages/database/src/cli.ts migrate",
    "db:reset": "node ./packages/database/src/cli.ts reset",
    "test:e2e": "node ./tests/e2e/ui.e2e.mjs",
    "seed": "node ./scripts/seed.mjs",
    "docs:endpoints": "node ./scripts/gen-endpoints.mjs"
  },
  "type": "module",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
