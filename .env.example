# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Data stores
DATABASE_URL=postgresql://livecoco:livecoco@localhost:5432/livecoco
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_DIR=./.data/objects
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=livecoco-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only

# Government price ingestion
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Authentication and messaging adapters
OTP_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=disabled

# Application security
SESSION_SECRET=replace-with-a-long-random-local-value
FIELD_ENCRYPTION_KEY=replace-with-a-local-development-key

# Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=


# Upload signing (generate a long random value; required in production)
UPLOAD_SIGNING_SECRET=replace-with-a-long-random-local-value
# Comma-separated E.164 numbers granted operator capabilities (still require OTP step-up)
OPERATOR_PHONES=
WORKER_INTERVAL_MS=900000
# Set to 1 only when the API is reachable solely through the web gateway (trusts x-forwarded-for for rate limits)
TRUST_PROXY=0
