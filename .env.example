# Runtime
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Data stores
# Pilot persistence shared by API and worker (ADR-007); ":memory:" for throwaway runs
LIVECOCO_DB_PATH=.data/livecoco.sqlite
DATABASE_URL=postgresql://livecoco:livecoco@localhost:5432/livecoco
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=livecoco-local
OBJECT_STORAGE_ACCESS_KEY=local-only
OBJECT_STORAGE_SECRET_KEY=local-only

# Government price ingestion
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Authentication and messaging adapters
OTP_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=disabled

# Application security
SESSION_SECRET=replace-with-a-long-random-local-value
FIELD_ENCRYPTION_KEY=replace-with-a-local-development-key

# Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=

